# Server
PORT=1930
DASHBOARD_PORT=1931
API_KEY=your-secret-key-here

# Security
ENCRYPTION_KEY=your-32-char-hex-key-here
JWT_SECRET=your-jwt-secret-change-in-production
# ALLOW_DEFAULT_SECRETS=true  # Uncomment ONLY for local dev; never in production

# Database
DATABASE_PATH=data/switchblade.db

# Auth / Python
AUTH_SCRIPT_PATH=scripts/auth/login.py
PYTHON_PATH=.venv/Scripts/python.exe
AUTH_SCRIPT_CWD=scripts/auth/
HEADLESS=true

# Logging
LOG_LEVEL=info  # debug | info | warn | error
POOLPROX_LOG_BODY_ENABLED=true
POOLPROX_LOG_BODY_FULL=true
POOLPROX_LOG_BODY_REDACT=false
POOLPROX_LOG_BODY_MAX_BYTES=65536

# Timeouts & Caching
POOLPROX_ACCOUNT_CACHE_TTL_MS=3000
POOLPROX_AUTH_PROCESS_TIMEOUT_MS=120000
POOLPROX_PROVIDER_REQUEST_TIMEOUT_MS=120000
POOLPROX_PROVIDER_QUOTA_TIMEOUT_MS=10000

# Providers
KIRO_PRO_UPGRADE=false
BROWSER_ENGINE=camoufox

# Relay
RELAY_MODE=disabled
RELAY_SERVER_URL=
RELAY_SECRET=your-relay-secret-here
RELAY_PEER_NAME=switchblade
RELAY_PUBLIC_BASE_URL=
RELAY_MAX_TUNNELS=5
RELAY_AUTO_START=false

# Captcha
CAPTCHA_SERVICE=
CAPTCHA_API_KEY=your-captcha-key-here

# Retention
LOG_RETENTION_DAYS=7
USAGE_RETENTION_DAYS=30
IMAGE_RETENTION_DAYS=7
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION=10

# Fallback
FALLBACK_ENABLED=true
FALLBACK_MAX_ATTEMPTS=3
FALLBACK_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_BURST=20

# Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SEC=300
